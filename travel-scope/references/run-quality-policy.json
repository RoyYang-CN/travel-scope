  },
  "english_residue_measurement": {
    "authoritative": true,
    "registered_at": "2026-10-30",
    "why": "v4.2.1 同时留着 7.5%（§3.2.5）与 2/7080＝0.03%（§16.2 第 5 条）两个数字；复算发现发布树里有四处各写一套 CJK 计数，且都没排除语言切换按钮上刻意保留的「中文」。口径不唯一，数字就没有可比性。",
    "scope": "读者可见英文正文文本：由 visual_qa 在注册视口点击 #lang-btn 后取 document.body.innerText 并导出到 visual-qa/spa-en-text.txt；其他英文产物（html_en/md_en/xlsx_en）用同一函数逐段测量，只是文本来源不同。",
    "counts_as_residue": "\\u4e00-\\u9fff\\u3400-\\u4dbf\\uf900-\\ufaff",
    "excluded_from_residue": "全角与中文标点（\\u3000-\\u303f、\\uff00-\\uffef）不计入残留——它们是排版不是未翻译正文；单独计数为 fullwidth_punctuation，不允许因为『不算』而从报告里消失。",
    "denominator": "chars = 同一段文本的字符总数（含空白）；ratio = leaked_cjk / chars，另附未经刻意项扣除的 ratio_unadjusted，两个数一起进报告。",
    "intentional_cjk": ["中文"],
    "intentional_cjk_note": "语言切换按钮在英文态必须写着「中文」，读者靠它切回去；这是刻意的，不是泄漏。命中位置逐条列出，不静默扣除。",
    "measured_anchors": {
      "purpose": "口径不能只在文档里自证：下面三个点用同一函数、同一浏览器、同一英文态跑，跑不出这些数就是代码漂移。",
      "how_to_replay": ".temp/v422_honest_map/V5_nonmap/tooling/v5c_evidence.py（只读打开产物，测完立刻复验 SHA）",
      "points": [
        {"artifact": "runs/travel_scope_run_202701_usa_california_v420_001/outputs/usa-california-travel-guide.html",
         "state": "EN", "chars": 4247, "raw_cjk": 944, "intentional_cjk": 2, "leaked_cjk": 942,
         "ratio": 0.221804,
         "matches": "v4.2.1 §2.2.3 记的『第 6 步实测 22.23%』（raw 944/4247＝0.222275）——v4.2.0 交付基线的英文态真有整段中文没翻译"},
        {"artifact": ".temp/v421/seal_run/outputs/usa-california-travel-guide.html",
         "state": "EN", "chars": 7080, "raw_cjk": 2, "intentional_cjk": 2, "leaked_cjk": 0, "ratio": 0.0,
         "matches": "§16.2 第 5 条的 2/7080＝0.03%：那 2 个汉字整条就是按钮「中文」，按本口径 intentional 与 leaked 分得开"},
        {"artifact": "v4.2.2 V2R dataset 经现行 renderer 的读者页（CA 4976 / PH 4642 字符）",
         "state": "EN", "raw_cjk": 2, "intentional_cjk": 2, "leaked_cjk": 0, "ratio": 0.0,
         "matches": "候补产物在 0.1% 阈值内，且不是空页：同页中文态分别 3094 字符/1701 汉字与 2000 字符/1064 汉字"}
      ],
      "scope_control": "同一份 v4.2.0 加州成品在 1280x720、1920x1080、390x844 三档视口下 leaked_cjk 恒为 942（390 档分母 4203）：残留判定不随视口漂移，视口只影响分母。",
      "negative_control": "在英文正文里植入『海岸线未翻译』（6 个汉字）：leaked_cjk=6、ratio=13.95%、breach=true 且样本串可定位——口径是分类，不是把数字抹平。"
    },
    "single_implementation": "scripts/en_residue_measure.py：发布树里任何第二份 CJK 计数（自行 re.findall 汉字类）都算口径漂移，由测试扫描禁止。"
  },
